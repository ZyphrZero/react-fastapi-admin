# ==============================================
# React FastAPI Admin 环境配置示例文件
# ==============================================
# 复制此文件为 .env 并根据您的环境修改相应的值

# ==============================================
# 基础应用配置
# ==============================================
APP_ENV=dev
# 应用版本
VERSION=0.1.0
# 应用标题
APP_TITLE=React FastAPI Admin
# 项目名称
PROJECT_NAME=React FastAPI Admin
# 应用描述
APP_DESCRIPTION=Modern admin system built with FastAPI and React
# 调试模式（true/false）
DEBUG=false
# 服务监听地址
HOST=0.0.0.0
# 服务监听端口
PORT=9999
# 是否启用热重载（留空时开发环境自动开启，生产环境自动关闭）
SERVER_RELOAD=

# ==============================================
# 初始管理员配置
# ==============================================
# 初始管理员账号（仅用于首次引导）
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NICKNAME=admin
# 初始管理员密码（留空时首次引导自动生成 12 位数字+符号密码，并只在启动控制台显示一次）
INITIAL_ADMIN_PASSWORD=

# ==============================================
# 安全配置
# ==============================================
# 应用密钥（生产环境请务必修改！使用 openssl rand -hex 32 生成）
SECRET_KEY=replace_with_a_random_64_char_secret_key_before_startup
# JWT 算法
JWT_ALGORITHM=HS256
# JWT 访问令牌过期时间（分钟）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT 刷新令牌过期时间（天）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================
# IP 白名单配置
# ==============================================
# IP 白名单（用逗号分隔，为空则不启用白名单检查）
# 示例: IP_WHITELIST=192.168.1.100,10.0.0.1,127.0.0.1
IP_WHITELIST=

# ==============================================
# 请求频率限制配置
# ==============================================
# 是否启用请求频率限制（true/false）
RATE_LIMIT_ENABLED=true
# 时间窗口内最大请求数
RATE_LIMIT_MAX_REQUESTS=1000
# 时间窗口大小（秒）
RATE_LIMIT_WINDOW_SECONDS=60

# ==============================================
# 密码策略配置
# ==============================================
# 密码最小长度
PASSWORD_MIN_LENGTH=8
# 是否要求包含大写字母（true/false）
PASSWORD_REQUIRE_UPPERCASE=true
# 是否要求包含小写字母（true/false）
PASSWORD_REQUIRE_LOWERCASE=true
# 是否要求包含数字（true/false）
PASSWORD_REQUIRE_DIGITS=true
# 是否要求包含特殊字符（true/false）
PASSWORD_REQUIRE_SPECIAL=true

# ==============================================
# 数据库配置
# ==============================================
# 数据库连接类型（sqlite/mysql/postgres）
DB_CONNECTION=sqlite
# SQLite 数据库文件名（当 DB_CONNECTION=sqlite 时使用）
DB_FILE=db.sqlite3

# MySQL/PostgreSQL 数据库配置（当 DB_CONNECTION=mysql/postgres 时使用）
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=fastapi_admin
# 数据库字符集（DB_CONNECTION=mysql 时必须为 utf8mb4）
# DB_CHARSET=utf8mb4
# 数据库模式名（DB_CONNECTION=postgres 时使用）
# DB_DATABASE_SCHEMA=public

# ==============================================
# Redis 配置
# ==============================================
# 是否启用 Redis（true/false；false 时健康探测报 skip，不发起连接）
REDIS_ENABLED=false
# Redis 主机地址
REDIS_HOST=localhost
# Redis 端口
REDIS_PORT=6379
# Redis 密码（可选）
REDIS_PASSWORD=
# Redis 数据库索引
REDIS_DB=0
# Redis 键前缀
REDIS_PREFIX=rbac:
# 认证用户缓存 TTL（秒；REDIS_ENABLED=true 时 is_authed 缓存用户信息，超时回库）
AUTH_USER_CACHE_TTL=600
# 权限缓存过期时间（秒）
PERMISSION_CACHE_TTL=3600

# ==============================================
# Celery 配置
# ==============================================
# 是否随后端进程内嵌启动 Celery worker 与 beat（开发便利开关；生产环境应使用独立容器，保持 false）
CELERY_AUTOSTART=false
# Celery worker 并发数（Linux/prefork 池下生效；Windows solo 池为单执行槽不生效）
CELERY_WORKER_CONCURRENCY=4
# 启用的 Celery 队列列表（逗号分隔，default 兜底）
CELERY_QUEUES=default

# ==============================================
# MinIO 对象存储配置
# ==============================================
# 是否启用 MinIO 对象存储（false 时启动不连接、健康探测报 skip）
MINIO_ENABLED=false
# MinIO 主机（host:port）
MINIO_ENDPOINT=localhost:9000
# MinIO 访问密钥
MINIO_ACCESS_KEY=minio
# MinIO 访问密钥
MINIO_SECRET_KEY=minio123
# 默认存储桶名称
MINIO_BUCKET_NAME=app
# 临时对象桶（按保留期回收）
MINIO_BUCKET_TMP=app-tmp
# 是否使用 HTTPS
MINIO_SECURE=false
# 预签名 URL 有效期（秒）
MINIO_URL_EXPIRES=300
# 客户端连接超时（秒；不可达时快速失败）
MINIO_CONNECTION_TIMEOUT=5.0
# app-tmp 临时对象保留期（小时），超期由回收任务删除
TMP_RETAIN_HOURS=48

# ==============================================
# LLM 服务配置（OpenAI 兼容客户端，app/utils/llm_client.py）
# ==============================================
# 是否启用 LLM 服务
LLM_API_ENABLED=true
# LLM 服务 Base URL（OpenAI 兼容 /v1 根）
LLM_API_BASE_URL=
# LLM 服务 API Key
LLM_API_KEY=
# 默认 LLM 模型
LLM_DEFAULT_MODEL=
# LLM 请求超时时间（秒）
LLM_REQUEST_TIMEOUT=600
# LLM 最大输出 token 数
LLM_MAX_TOKENS=4096
# LLM 服务商：qwen|vllm|openai|deepseek（思考模式等私有参数按此分发）
LLM_PROVIDER=qwen
# LLM 是否启用思考模式
LLM_ENABLE_THINKING=false
# qwen 思考内容是否随响应保留
LLM_PRESERVE_THINKING=false
# qwen 工具选择策略（DashScope 约定 none）
LLM_TOOL_CHOICE=none
# 是否启用权限冲突检查（true/false）
PERMISSION_CONFLICT_CHECK=true

# ==============================================
# 生产环境配置示例
# ==============================================
# 如果您在生产环境中，请参考以下配置：
# APP_ENV=prod
# DEBUG=false
# SECRET_KEY=your_production_secret_key
# DB_CONNECTION=mysql
# DB_HOST=your_database_host
# DB_PASSWORD=your_secure_password
# IP_WHITELIST=your_server_ip,your_office_ip

# ==============================================
# 注意事项
# ==============================================
# 1. 生产环境请务必修改 SECRET_KEY
# 2. 数据库密码请使用强密码
# 3. 存储配置请在系统设置页面填写真实配置
# 4. IP 白名单建议在生产环境中启用
# 5. 请勿将 .env 文件提交到版本控制系统
